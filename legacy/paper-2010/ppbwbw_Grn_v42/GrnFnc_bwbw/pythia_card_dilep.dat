!...Fix (0) or event-based (1) PS scale
      PSSCALE=1

!...Parton showering on or off  
      MSTP(61)=1
      MSTP(71)=1
 
!...Fragmentation/hadronization on or off 
      MSTJ(1)=1
 
!...Multiple interactions on or off 
      MSTP(81)=0 

!...Switch off W-boson deacy, but into muon
      MDME(190,1) = 0
      MDME(191,1) = 0
      MDME(192,1) = 0
      MDME(193,1) = 0
      MDME(194,1) = 0
      MDME(195,1) = 0
      MDME(196,1) = 0
      MDME(197,1) = 0
      MDME(198,1) = 0
      MDME(199,1) = 0
      MDME(200,1) = 0
      MDME(201,1) = 0
      MDME(202,1) = 0
      MDME(203,1) = 0
      MDME(204,1) = 0
      MDME(205,1) = 0
      MDME(206,1) = 0
      MDME(207,1) = 1
      MDME(208,1) = 0
      MDME(209,1) = 0
 
      LHAPATH=../../pythia-pgs/src/PDFsets
